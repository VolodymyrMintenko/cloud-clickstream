{
  "script": {
    "config": {
      "environment": "prod"
    }
  },
  "engines": {
    "flink": {
      "config": {
        "table.exec.source.idle-timeout": "10 s"
      }
    },
    "vertx": {
      "authKind": [
        "JWT"
      ],
      "config": {
        "jwtAuth": {
          "pubSecKeys": [
            {
              "algorithm": "RS256",
              "buffer": ""
            }
          ],
          "jwtOptions": {
            "issuer": "https://datasqrl.us.auth0.com/",
            "audience": [
              "https://dev.datasqrl.com"
            ]
          }
        }
      }
    }
  }
}
